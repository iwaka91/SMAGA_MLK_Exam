# RC1 — hanya masukkan sebagai ENV VARS pada layanan backend. Jangan unggah .env ke Netlify.
SMAGA_ENV=production
SMAGA_DEMO_MODE=0
SMAGA_SKIP_NUMBAS=1
SMAGA_NO_BROWSER=1
SMAGA_PUBLIC_URL=https://DOMAIN-APLIKASI-ANDA
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ISI_DI_DASHBOARD_HOSTING_SAJA
SMAGA_STORAGE_BUCKET=exam-assets
SMAGA_STORAGE_LIMIT_MB=1024
SMAGA_STORAGE_WARN_PCT=75
SMAGA_STORAGE_CRITICAL_PCT=90
SMAGA_ASSET_RETENTION_DAYS=180
SMAGA_ORPHAN_RETENTION_DAYS=30
SMAGA_CLEANUP_INTERVAL_HOURS=12
